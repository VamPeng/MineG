MINEG_ENV=local
MINEG_HTTP_ADDRESS=:8080
MINEG_DATABASE_URL=postgres://mineg:local-only-change-me@127.0.0.1:5432/mineg?sslmode=disable
MINEG_ADMIN_ORIGIN=http://localhost:5173
MINEG_CURSOR_HMAC_KEY=mineg-local-cursor-key-change-before-deployment
# Leave every OSS setting empty for account-only local development.
MINEG_OSS_REGION=
MINEG_OSS_BUCKET=
# local/test only: public endpoint plus a complete, expiring AssumeRole result.
MINEG_OSS_PUBLIC_ORIGIN=
MINEG_OSS_ACCESS_KEY_ID=
MINEG_OSS_ACCESS_KEY_SECRET=
MINEG_OSS_SECURITY_TOKEN=
MINEG_OSS_STS_EXPIRATION=
# deployment only: internal endpoint plus ECS RAM Role; local STS values above
# must remain empty.
MINEG_OSS_INTERNAL_ORIGIN=
MINEG_OSS_ECS_RAM_ROLE=
MINEG_REQUEST_TIMEOUT=15s
MINEG_SHUTDOWN_TIMEOUT=20s
MINEG_READ_HEADER_TIMEOUT=5s
