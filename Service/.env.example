MINEG_ENV=local
MINEG_HTTP_ADDRESS=:8080
MINEG_DATABASE_URL=postgres://mineg:local-only-change-me@127.0.0.1:5432/mineg?sslmode=disable
MINEG_ADMIN_ORIGIN=http://localhost:5173
MINEG_CURSOR_HMAC_KEY=mineg-local-cursor-key-change-before-deployment
# Leave all four OSS settings empty for local account-only development. A
# deployment must set them and uses ECS RAM Role temporary credentials only.
MINEG_OSS_REGION=
MINEG_OSS_BUCKET=
MINEG_OSS_INTERNAL_ORIGIN=
MINEG_OSS_ECS_RAM_ROLE=
MINEG_REQUEST_TIMEOUT=15s
MINEG_SHUTDOWN_TIMEOUT=20s
MINEG_READ_HEADER_TIMEOUT=5s
