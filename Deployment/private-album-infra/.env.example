# 复制为 .env 后填写真实值；不要提交 .env。

ALIYUN_REGION_ID=cn-example
OSS_BUCKET_NAME=replace-with-private-bucket-name
ECS_RAM_ROLE_NAME=replace-with-private-role-name
OSS_INTERNAL_ENDPOINT=https://oss-cn-example-internal.aliyuncs.com
OSS_READ_PROBE_KEY=avatars/replace-with-non-sensitive-probe-object

# 应用部署阶段再填写。
APP_DOMAIN=replace-with-private-domain
APP_REPOSITORY_URL=replace-with-private-repository-url
