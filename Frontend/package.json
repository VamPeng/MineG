{
  "name": "mineg-admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-typescript ../Service/api/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/schema.d.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "check": "npm run api:check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.14.3",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.19.15",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.6.2",
    "happy-dom": "20.11.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.8"
  }
}
