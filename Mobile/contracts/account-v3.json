{
  "contractVersion": "3.0.0",
  "wireVersion": "account-v3",
  "status": "BASELINED",
  "scope": "E1_ACCOUNT_ADMISSION_WITHOUT_MEDIA_KEYS",
  "commands": [
    "AccountSignUp",
    "AccountSignIn",
    "AccountRestoreSession",
    "AccountSignOut",
    "AccountRefreshReviewStatus",
    "ProfileGetCurrent",
    "ProfileUpdateCurrent"
  ],
  "queries": [
    "GetAccountRouteSnapshot",
    "GetCurrentProfileSnapshot"
  ],
  "events": [
    "AccountRouteChanged",
    "CurrentProfileChanged"
  ],
  "effectActions": {
    "TransportEffect": [
      "sendApiRequest"
    ],
    "SecureStoreEffect": [
      "readSecrets",
      "writeSecrets",
      "deleteSecrets"
    ]
  },
  "registrationFields": [
    "phone",
    "password",
    "device_installation_id",
    "platform"
  ],
  "rules": [
    "Registration does not create or submit a user key bundle",
    "Administrator approval transitions the account directly to APPROVED",
    "Admission never depends on another member device, key grant, or family envelope",
    "Passwords and tokens are never persisted in Core SQLite or operation recovery records"
  ],
  "jsonFieldStyle": "lowerCamelCase",
  "apiFieldStyle": "snake_case"
}
