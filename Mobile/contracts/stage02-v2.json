{
  "contractVersion": "2.1.0",
  "wireVersion": "stage02-v2",
  "status": "FROZEN",
  "scope": "M3_D_PROFILE_AVATAR_PRIVATE_MEDIA_LOCAL_INDEX_SETTINGS",
  "commands": [
    "ProfileUpdateAvatar",
    "PrivateMediaList",
    "StartForegroundLocalScan",
    "UpdateBackupSettings"
  ],
  "queries": [
    "ListPrivateMediaSnapshot",
    "GetBackupSettings",
    "GetLocalLibrarySummary",
    "ListLocalAlbums",
    "ListLocalMedia"
  ],
  "events": [
    "CurrentProfileChanged",
    "PrivateMediaSnapshotChanged",
    "BackupSettingsChanged",
    "LocalLibraryIndexChanged",
    "LocalScanProgressChanged"
  ],
  "bridgeSnapshots": {
    "CurrentProfileSnapshot": [
      "id",
      "nickname",
      "maskedPhone",
      "avatarUrl",
      "version",
      "updatedAt"
    ],
    "PrivateMediaSnapshot": [
      "items",
      "refreshedAt"
    ],
    "OwnerMediaSummary": [
      "id",
      "mediaType",
      "contentRevision",
      "capturedAt",
      "createdAt"
    ],
    "BackupSettingsSnapshot": [
      "autoBackupEnabled",
      "allowCellularBackup",
      "updatedAt"
    ],
    "LocalLibrarySummary": [
      "generationId",
      "indexedCount",
      "completedAt"
    ],
    "LocalAlbumPage": [
      "items",
      "nextCursor"
    ],
    "LocalMediaPage": [
      "items",
      "nextCursor"
    ]
  },
  "effectActions": {
    "TransportEffect": [
      "sendApiRequest",
      "uploadObject"
    ],
    "SecureStoreEffect": [
      "readSecrets",
      "writeSecrets"
    ],
    "MediaSourceEffect": [
      "getPermissionSnapshot",
      "listAlbums",
      "listMedia"
    ]
  },
  "rules": [
    "Avatar object transfer is performed only by TransportEffect",
    "Private media snapshots are account isolated in Core SQLite",
    "Android maps immutable snapshots to UI and never merges domain list state",
    "Foreground local scans always start with an empty cursor and are never recovered",
    "Only a completed generation can replace the visible local-library index",
    "Backup settings are preferences only and never schedule or upload work in Batch D"
  ],
  "jsonFieldStyle": "lowerCamelCase",
  "apiFieldStyle": "snake_case"
}
