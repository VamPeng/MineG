{
  "contractVersion": "2.0.0",
  "wireVersion": "stage02-v2",
  "status": "BASELINED",
  "scope": "M3_D_PROFILE_AVATAR_KEY_GRANT_PRIVATE_MEDIA",
  "compatibleWith": "stage02-v1@1.0.0",
  "commands": [
    "CoordinateFamilyKeyGrants",
    "ProfileUpdateAvatar",
    "PrivateMediaList"
  ],
  "queries": [
    "ListPrivateMediaSnapshot"
  ],
  "events": [
    "CurrentProfileChanged",
    "PrivateMediaSnapshotChanged"
  ],
  "bridgeSnapshots": {
    "KeyGrantCoordinationResult": ["completed", "completedCount", "keysAvailable"],
    "CurrentProfileSnapshot": ["id", "nickname", "maskedPhone", "avatarUrl", "version", "updatedAt"],
    "PrivateMediaSnapshot": ["items", "refreshedAt"],
    "OwnerMediaSummary": ["id", "mediaType", "contentRevision", "capturedAt", "createdAt"]
  },
  "secureStoreNames": [
    "keys.deviceWrapKey",
    "keys.userPublicKey",
    "keys.deviceUnlockBlob"
  ],
  "effectActions": {
    "TransportEffect": ["sendApiRequest", "uploadObject"],
    "SecureStoreEffect": ["readSecrets", "writeSecrets"]
  },
  "rules": [
    "Key bundle and pending grant responses are parsed only by Core",
    "Decrypted user and family keys remain only in Core controlled memory",
    "Avatar object transfer is performed only by TransportEffect",
    "Private media snapshots are account isolated in Core SQLite",
    "Android maps immutable snapshots to UI and never merges domain list state"
  ],
  "jsonFieldStyle": "lowerCamelCase",
  "apiFieldStyle": "snake_case"
}
